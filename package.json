    "gulp": "^5.0.1",
    "gulp-terser": "^2.1.0",
    "prettier": "^3.8.1",
    "three": "^0.183.2",
    "tsc-watch": "^7.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2"
  },
  "author": {
    "name": "Hernan Castilla",
    "email": "hcastillaq@gmail.com",
